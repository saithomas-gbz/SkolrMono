{
  "title": "Skolr - PostgreSQL Overview",
  "uid": "skolr-postgres",
  "version": 1,
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(pg_up, db)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances UP",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(pg_up{db=~\"$db\"})",
          "legendFormat": "UP"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connexions actives",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{db=~\"$db\", state=\"active\"})",
          "legendFormat": "Actives"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taille totale BDD",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(pg_database_size_bytes{db=~\"$db\"})",
          "legendFormat": "Taille"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Connexions par base",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_activity_count{db=~\"$db\", state=\"active\"}",
          "legendFormat": "{{db}} - {{state}}"
        },
        {
          "expr": "pg_stat_activity_count{db=~\"$db\", state=\"idle\"}",
          "legendFormat": "{{db}} - {{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions par seconde",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit_total{db=~\"$db\"}[1m])",
          "legendFormat": "{{db}} commits/s"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback_total{db=~\"$db\"}[1m])",
          "legendFormat": "{{db}} rollbacks/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit_total{db=~\"$db\"}[1m]) / (rate(pg_stat_database_blks_hit_total{db=~\"$db\"}[1m]) + rate(pg_stat_database_blks_read_total{db=~\"$db\"}[1m]) + 0.001)",
          "legendFormat": "{{db}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dead tuples (besoin vacuum)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (db) (pg_stat_user_tables_n_dead_tup{db=~\"$db\"})",
          "legendFormat": "{{db}}"
        }
      ]
    }
  ]
}
