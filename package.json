{
  "name": "skolr-mono",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "prisma": "7.5.0"
  },
  "scripts": {
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:dev": "bun run scripts/seed-dev.ts",
    "db:migrate:dev": "bun run scripts/db-migrate-dev.ts",
    "db:run:stack": "bun run scripts/db-run-stack.ts",
    "sentry:setup": "bash scripts/sentry-setup.sh",
    "sentry:up": "bash scripts/sentry-up.sh",
    "sentry:down": "bash scripts/sentry-down.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "knip": "^5.86.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
