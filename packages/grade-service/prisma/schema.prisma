// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum GradeStatus {
  PENDING
  GRADED
  ABSENT
  EXEMPT
}

model User {
  id      String  @id @unique @default(uuid())
  name    String
  email   String  @unique
  classId String
  class   Class   @relation(fields: [classId], references: [id])
  grades  Grade[]
}

model Class {
  id          String       @id @unique @default(uuid())
  name        String
  description String
  students    User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  grades      Grade[]
  assignments Assignment[]
}

model Subject {
  id          String   @id @unique @default(uuid())
  name        String
  description String
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id               String       @id @unique @default(uuid())
  name             String
  description      String
  subjectId        String?
  subject          Subject?     @relation(fields: [subjectId], references: [id])
  relatedCourses   Course[]     @relation("CourseRelations")
  relatedCoursesOf Course[]     @relation("CourseRelations")
  grades           Grade[]
  topics           Topic[]
  assignments      Assignment[]
}

model Topic {
  id          String   @id @unique @default(uuid())
  name        String
  description String
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String?
  classId     String
  class       Class            @relation(fields: [classId], references: [id])
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id])
  teacherId   String
  assignedAt  DateTime
  dueAt       DateTime?
  maxScore    Float            @default(20)
  coefficient Float            @default(1)
  status      AssignmentStatus @default(DRAFT)
  grades      Grade[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([classId, courseId])
  @@index([assignedAt])
}

model Grade {
  id           String      @id @unique @default(uuid())
  assignmentId String
  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  classId      String
  class        Class       @relation(fields: [classId], references: [id])
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id])
  status       GradeStatus @default(PENDING)
  value        Float?
  comment      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([assignmentId, userId])
}
