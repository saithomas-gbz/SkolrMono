{
  "name": "grade-service",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "build": "bun build ./index.ts --outdir ./dist --target node --external @prisma/client --external .prisma/client",
    "start": "bun run ./dist/index.js",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "7.5.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.2"
  }
}
