# Backend (monolithe modulaire) — dev hors Docker.
# Le compose racine injecte ces variables ; ce fichier sert au dev local direct.

PORT=3001
# Base unique multi-schema (les schémas sont créés par les migrations Prisma).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skolr?schema=public
JWT_SECRET=your_secure_jwt_secret_here

# Jeton d'accès (JWT) court, stateless et non révocable avant expiration ; jeton
# de rafraîchissement long, tracé côté serveur (table RefreshToken), révocable
# et soumis à rotation à chaque usage (voir modules/auth/lib/refreshTokenService.ts).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# À true uniquement en production derrière un reverse proxy de confiance (nginx,
# load balancer…) : fait lire l'IP client depuis X-Forwarded-For pour un
# rate-limiting par IP réelle. Laisser false sinon (un client pourrait sinon
# usurper son IP apparente via ce même en-tête).
TRUST_PROXY=false

# Allowlist CORS séparée par des virgules. Défaut dev (localhost) codé en dur
# dans app.ts si absent — à définir explicitement en production.
CORS_ORIGINS=

# Rate-limiting global (@fastify/rate-limit) — défauts dans app.ts si absents.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- OAuth Google (auth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3001/auth/login/google/callback
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3003/auth/success
GOOGLE_OAUTH_ERROR_URL=http://localhost:3003/auth/error

# --- Email transactionnel (auth) ---
MAIL_PROVIDER=console
MAIL_FROM=no-reply@skolr.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITATION_URL=http://localhost:3003/auth/accept-invitation
PASSWORD_RESET_URL=http://localhost:3003/auth/reset-password

# --- Stripe (billing, mode test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_SUCCESS_URL=http://localhost:3003/admin/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3003/admin/billing?canceled=1

# --- Pièces jointes (message → S3/MinIO, planning → disque via UPLOADS_DIR) ---
STORAGE_BACKEND=local
UPLOADS_DIR=./uploads
MESSAGE_MAX_FILE_SIZE_BYTES=5242880
MESSAGE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/gif,image/webp
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skolr-messages
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Observabilité ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
