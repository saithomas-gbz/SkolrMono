DATABASE_URL=postgresql://postgres:postgres@localhost:5437/skolr_message?schema=public
PORT=3010
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=your_secure_jwt_secret_here

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Stockage des pièces jointes ---
# "local" (défaut) : disque local dans UPLOADS_DIR
# "s3"            : S3-compatible (MinIO ou AWS S3)
STORAGE_BACKEND=local
UPLOADS_DIR=./uploads
MESSAGE_MAX_FILE_SIZE_BYTES=5242880
MESSAGE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/gif,image/webp

# Paramètres S3 (uniquement si STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skolr-messages
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
