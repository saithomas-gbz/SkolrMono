generator client {
  provider      = "prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AbsenceRole {
  STUDENT
  TEACHER
}

model Session {
  id             String    @id @unique @default(uuid())
  classId        String
  courseId       String
  teacherId      String
  room           String?
  startAt        DateTime
  endAt          DateTime
  recurrenceRule String?
  absences       Absence[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Absence {
  id        String      @id @unique @default(uuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  role      AbsenceRole
  justified Boolean     @default(false)
  reason    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  justificationLinks AbsenceJustificationLink[]

  @@unique([sessionId, userId])
}

enum JustificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model AbsenceJustification {
  id            String              @id @default(uuid())
  studentId     String
  status        JustificationStatus @default(DRAFT)
  reason        String
  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?
  documents     JustificationDocument[]
  absences      AbsenceJustificationLink[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([studentId])
  @@index([status])
}

model AbsenceJustificationLink {
  justificationId String
  justification   AbsenceJustification @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  absenceId       String
  absence         Absence              @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@unique([justificationId, absenceId])
  @@index([absenceId])
}

model JustificationDocument {
  id              String               @id @default(uuid())
  justificationId String
  justification   AbsenceJustification @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  uploadedAt      DateTime             @default(now())

  @@index([justificationId])
}
