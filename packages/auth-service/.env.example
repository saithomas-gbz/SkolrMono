GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/login/google/callback

# JWT Secret for token signing
JWT_SECRET=your_secure_jwt_secret_here

# Database connection URL for PostgreSQL
