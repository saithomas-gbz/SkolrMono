GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/login/google/callback

# JWT Secret for token signing
JWT_SECRET=your_secure_jwt_secret_here

# Database connection URL for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skolr_auth?schema=public"

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Email transactionnel ---
# MAIL_PROVIDER=console loggue les emails (dev/test) ; MAIL_PROVIDER=smtp envoie via SMTP_*
MAIL_PROVIDER=console
MAIL_FROM=no-reply@skolr.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# URL de la page d'acceptation d'invitation côté frontend
INVITATION_URL=http://localhost:3003/auth/accept-invitation

# URL de la page de réinitialisation de mot de passe côté frontend
PASSWORD_RESET_URL=http://localhost:3003/auth/reset-password
