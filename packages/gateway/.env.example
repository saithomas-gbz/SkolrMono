# Port the gateway listens on
PORT=3001

# URL of the auth-service (Docker: http://auth-service:3000)
AUTH_SERVICE_URL=http://localhost:3000

# URL of the class-service (Docker: http://class-service:3002)
CLASS_SERVICE_URL=http://localhost:3002

# URL of the grade-service (Docker: http://grade-service:3007)
GRADE_SERVICE_URL=http://localhost:3007

# URL of the planning-service (Docker: http://planning-services:3008)
PLANNING_SERVICE_URL=http://localhost:3008

# OpenAPI JSON paths on each upstream (defaults: /openapi.json)
AUTH_OPENAPI_PATH=/openapi.json
CLASS_OPENAPI_PATH=/openapi.json
GRADE_OPENAPI_PATH=/openapi.json
PLANNING_OPENAPI_PATH=/openapi.json

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
