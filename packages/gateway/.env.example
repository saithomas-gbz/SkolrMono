CLASS_SERVICE_URL=http://localhost:3002

# Path on class-service for OpenAPI JSON (gateway merges under /class)
CLASS_OPENAPI_PATH=/openapi.json

# URL of the grade-service (use service name when running via Docker Compose)
GRADE_SERVICE_URL=http://localhost:3007

# Path on grade-service for OpenAPI JSON (gateway merges under /grade)
GRADE_OPENAPI_PATH=/openapi.json

