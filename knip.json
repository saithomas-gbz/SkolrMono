{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/auth-service": {
      "project": ["src/**/*.ts"]
    },
    "packages/gateway": {
      "project": ["src/**/*.ts"]
    },
    "packages/frontend": {
      "entry": [
        "pages/**/*.vue",
        "composables/**/*.ts",
        "components/**/*.vue",
        "__tests__/**/*.ts"
      ],
      "project": ["**/*.{ts,vue}", "!**/.nuxt/**", "!**/.output/**"]
    }
  },
  "ignoreDependencies": ["typescript-eslint", "@prisma/adapter-pg", "@prisma/client", "nuxt-auth-utils"],
  "ignore": ["eslint.config.js"]
}
