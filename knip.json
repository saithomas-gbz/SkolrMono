{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/auth-service": {
      "project": ["src/**/*.ts"]
    },
    "packages/gateway": {
      "project": ["src/**/*.ts"]
    },
    "packages/class-service": {
      "project": ["src/**/*.ts"]
    },
    "packages/message-service": {
      "project": ["src/**/*.ts", "prisma/**/*.ts"]
    },
    "packages/frontend": {
      "project": ["app/**/*.{vue,ts,tsx,jsx}", "server/**/*.ts"],
      "ignoreDependencies": ["vue-router", "chart.js", "primeicons"]
    }
  },
  "ignoreDependencies": ["@prisma/client"],
  "eslint": {
    "config": ["eslint.config.js", "eslint.base.mjs"]
  }
}
