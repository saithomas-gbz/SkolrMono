{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/auth-service": {
      "project": ["src/**/*.ts"]
    },
    "packages/gateway": {
      "project": ["src/**/*.ts"]
    },
    "packages/class-service": {
      "project": ["src/**/*.ts"]
    },
    "packages/frontend": {
      "project": ["app/**/*.{vue,ts,tsx,jsx}", "server/**/*.ts"],
      "ignoreDependencies": ["vue", "vue-router"]
    }
  },
  "ignoreDependencies": ["typescript-eslint", "@prisma/client"],
  "ignoreBinaries": ["eslint"],
  "ignore": ["eslint.config.js"]
}
