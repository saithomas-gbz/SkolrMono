# Root-level env vars (shared across services / Docker Compose)
# Each package has its own .env.example for service-specific variables.

# PostgreSQL (auth — service `postgres`, port host 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skolr_auth

# Base class (service `postgres-class`, port host 5433)
POSTGRES_CLASS_DB=skolr_class
