# SkolrMono — variables pour Docker Compose (développement local)
#
# Démarrage rapide :
#   cp .env.example .env
#   docker compose up -d
#   bun run db:run:stack
#
# Chaque package a aussi son propre .env.example pour le dev hors Docker.

# --- PostgreSQL (identifiants partagés) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Noms des bases (un conteneur Postgres par service)
POSTGRES_AUTH_DB=skolr_auth
POSTGRES_CLASS_DB=skolr_class
POSTGRES_GRADE_DB=skolr_grade
POSTGRES_PLANNING_DB=skolr_planning
POSTGRES_NOTIFICATION_DB=skolr_notification
POSTGRES_MESSAGE_DB=skolr_message
POSTGRES_BILLING_DB=skolr_billing
POSTGRES_PARENT_DB=skolr_parent

# Ports exposés sur la machine hôte (conteneur : 5432)
POSTGRES_AUTH_PORT=5432
POSTGRES_CLASS_PORT=5433
POSTGRES_GRADE_PORT=5434
POSTGRES_PLANNING_PORT=5435
POSTGRES_NOTIFICATION_PORT=5436
POSTGRES_MESSAGE_PORT=5437
POSTGRES_BILLING_PORT=5438
POSTGRES_PARENT_PORT=5439

# --- Services applicatifs (ports hôte) ---
AUTH_SERVICE_PORT=3000
GATEWAY_PORT=3001
GRADE_SERVICE_PORT=3007
PLANNING_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
MESSAGE_SERVICE_PORT=3010
BILLING_SERVICE_PORT=3011
PARENT_SERVICE_PORT=3012
FRONTEND_PORT=3003

# --- auth-service ---
JWT_SECRET=your_secure_jwt_secret_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/login/google/callback
# URLs frontend vers lesquelles rediriger après le callback OAuth Google
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3003/auth/success
GOOGLE_OAUTH_ERROR_URL=http://localhost:3003/auth/error

# Email transactionnel (invitations, bienvenue) — voir .env de chaque service
# MAIL_PROVIDER=console loggue les emails (dev/test) ; MAIL_PROVIDER=smtp envoie via SMTP_*
MAIL_PROVIDER=console
MAIL_FROM=no-reply@skolr.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITATION_URL=http://localhost:3003/auth/accept-invitation
PASSWORD_RESET_URL=http://localhost:3003/auth/reset-password

# --- billing-service (Stripe, mode test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_SUCCESS_URL=http://localhost:3003/admin/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3003/admin/billing?canceled=1

# --- URLs internes Docker (réseau skolr_network) ---
# Ne pas changer sauf si vous renommez les services dans docker-compose.yml
AUTH_SERVICE_URL=http://auth-service:3000
CLASS_SERVICE_URL=http://class-service:3002
GRADE_SERVICE_URL=http://grade-service:3007
PLANNING_SERVICE_URL=http://planning-services:3008
BILLING_SERVICE_URL=http://billing-service:3011
PARENT_SERVICE_URL=http://parent-service:3012

# --- frontend ---
NUXT_PUBLIC_GATEWAY_BASE_URL=/api
NUXT_PUBLIC_GATEWAY_WS_BASE_URL=ws://localhost:3001
NUXT_PUBLIC_GATEWAY_DIRECT_URL=http://localhost:3001
GATEWAY_INTERNAL_URL=http://gateway:3001

# --- Grafana (3030 pour éviter le conflit avec auth-service sur 3000) ---
GRAFANA_PORT=3030
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Sentry self-hosted (optionnel) ---
# Installation (une fois, ~16 Go RAM) :
#   bun run sentry:setup
# Puis créer org + projets sur http://localhost:9000
#
SENTRY_PORT=9000
SENTRY_ADMIN_EMAIL=admin@skolr.local
SENTRY_ADMIN_PASSWORD=admin
# Version du dépôt getsentry/self-hosted (vide = dernière release)
# SENTRY_VERSION=26.5.0

# DSN après création des projets dans l’UI Sentry :
# Backend (conteneurs Docker → nginx interne)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Frontend (navigateur → localhost)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Exemple une fois le projet créé :
# SENTRY_DSN=http://VOTRE_CLE@skolr_sentry_nginx:80/1
# NUXT_PUBLIC_SENTRY_DSN=http://VOTRE_CLE@localhost:9000/1

# Upload des source maps (CI/build uniquement, SaaS ou self-hosted)
SENTRY_ORG=
SENTRY_PROJECT=frontend
SENTRY_AUTH_TOKEN=

# --- RabbitMQ ---
#
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
