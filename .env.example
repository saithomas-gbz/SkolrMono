# SkolrMono — variables pour Docker Compose (développement local)
#
# Démarrage rapide :
#   cp .env.example .env
#   docker compose up -d
#   bun run db:run:stack
#
# Chaque package a aussi son propre .env.example pour le dev hors Docker.

# --- PostgreSQL (base unique multi-schema) ---
# Le backend est un monolithe modulaire : une seule base Postgres contenant
# tous les schémas (auth, class, grade, planning, message, notification,
# billing, parent). Les schémas sont créés par les migrations Prisma.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skolr
# Port exposé sur la machine hôte (conteneur : 5432)
POSTGRES_PORT=5432

# --- Backend (monolithe modulaire) ---
BACKEND_PORT=3001
FRONTEND_PORT=3003

# --- Auth (JWT + OAuth Google) ---
JWT_SECRET=your_secure_jwt_secret_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3001/auth/login/google/callback
# URLs frontend vers lesquelles rediriger après le callback OAuth Google
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3003/auth/success
GOOGLE_OAUTH_ERROR_URL=http://localhost:3003/auth/error

# Email transactionnel (invitations, bienvenue)
# MAIL_PROVIDER=console loggue les emails (dev/test) ; MAIL_PROVIDER=smtp envoie via SMTP_*
MAIL_PROVIDER=console
MAIL_FROM=no-reply@skolr.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITATION_URL=http://localhost:3003/auth/accept-invitation
PASSWORD_RESET_URL=http://localhost:3003/auth/reset-password

# --- Billing (Stripe, mode test) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
STRIPE_SUCCESS_URL=http://localhost:3003/admin/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3003/admin/billing?canceled=1

# --- frontend ---
NUXT_PUBLIC_GATEWAY_BASE_URL=/api
NUXT_PUBLIC_GATEWAY_WS_BASE_URL=ws://localhost:3001
NUXT_PUBLIC_GATEWAY_DIRECT_URL=http://localhost:3001
# URL interne (réseau skolr_network) utilisée par le proxy Nuxt côté serveur.
GATEWAY_INTERNAL_URL=http://backend:3001

# --- Grafana (3030 pour éviter le conflit avec le backend sur 3001) ---
GRAFANA_PORT=3030
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Sentry self-hosted (optionnel) ---
# Installation (une fois, ~16 Go RAM) :
#   bun run sentry:setup
# Puis créer org + projets sur http://localhost:9000
#
SENTRY_PORT=9000
SENTRY_ADMIN_EMAIL=admin@skolr.local
SENTRY_ADMIN_PASSWORD=admin
# Version du dépôt getsentry/self-hosted (vide = dernière release)
# SENTRY_VERSION=26.5.0

# DSN après création des projets dans l’UI Sentry :
# Backend (conteneurs Docker → nginx interne)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Frontend (navigateur → localhost)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Exemple une fois le projet créé :
# SENTRY_DSN=http://VOTRE_CLE@skolr_sentry_nginx:80/1
# NUXT_PUBLIC_SENTRY_DSN=http://VOTRE_CLE@localhost:9000/1

# Upload des source maps (CI/build uniquement, SaaS ou self-hosted)
SENTRY_ORG=
SENTRY_PROJECT=frontend
SENTRY_AUTH_TOKEN=

# --- MinIO (stockage S3-compatible pour les pièces jointes message) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# STORAGE_BACKEND=s3 route les pièces jointes du module message vers MinIO.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=skolr-messages
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
